{"html":"\n    <div class=\"app\" id=\"app\" data-mode=\"report\" data-theme=\"midnight\" style=\"--font-doc: &quot;Source Serif 4&quot;, &quot;Source Serif 4&quot;, &quot;Source Serif Pro&quot;, Cambria, Georgia, serif; --font-doc-size: 15px; --font-doc-line: 1.7;\">\n      <!-- The reader's theme before the first paint (N3): the FIRST child of #app, so #app exists and nothing under it has\n           painted. A script is not a box, so the grid gains no item. -->\n      \n\n      <a class=\"v2-skip\" href=\"#\">Skip to content</a>\n\n      <!-- THE ONE SIDEBAR (v2 shell, interface/v2/shell.js): the same navigation for the app's pages and the Docs pages. 240 px,\n           folded to a 64 px icon rail (Ctrl/Cmd+B), a drawer below 1024 px; on a phone the bottom tab bar (#v2TabBar) leads and\n           the sidebar is the drawer behind its Menu. The id stays \"library\": the drawer, the fold and the width are the library's. -->\n      <aside class=\"library v2-side\" id=\"library\" aria-label=\"Main navigation\" data-v2-shell=\"1\">\n        <div class=\"v2s-head\">\n          <a class=\"v2s-brand\" href=\"#\" aria-label=\"Sentinel, home\">\n            <svg class=\"v2-mark\" data-brand-mark=\"\" width=\"20\" height=\"20\" viewBox=\"0 0 100 100\" aria-hidden=\"true\" focusable=\"false\"><path fill=\"currentColor\" d=\"M45.99 10.61L0.76 91.88L35.45 71.76ZM50 0L55.82 72.89L50 100L44.18 72.89ZM54.01 10.61L64.55 71.76L99.24 91.88Z\"></path></svg>\n            <span class=\"v2s-word\">Sentinel</span>\n          </a>\n          \n          \n        </div>\n        <button class=\"v2s-search\" type=\"button\" data-act=\"v2-search\">\n          <svg class=\"v2i\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#search\"></use></svg>\n          <span class=\"v2s-search-t\">Search or jump to…</span><kbd>Ctrl K</kbd>\n        </button>\n        <nav class=\"v2s-nav\" id=\"v2Nav\" aria-label=\"Pages\"><a class=\"v2s-item\" href=\"#\" data-nav=\"home\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#home\"></use></svg><span class=\"v2s-l\">Home</span></a><a class=\"v2s-item is-active\" href=\"#\" data-nav=\"contracts\" aria-current=\"page\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#contracts\"></use></svg><span class=\"v2s-l\">Contracts</span><span class=\"v2s-n\">12</span></a><a class=\"v2s-item\" href=\"#\" data-nav=\"files\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#folder\"></use></svg><span class=\"v2s-l\">Files</span></a><a class=\"v2s-item\" href=\"#\" data-nav=\"insights\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#insights\"></use></svg><span class=\"v2s-l\">Insights</span></a><a class=\"v2s-item\" href=\"#\" data-nav=\"ask\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#ask\"></use></svg><span class=\"v2s-l\">Ask</span></a><div class=\"v2s-sub v2s-sub-more\">More</div><a class=\"v2s-item\" href=\"#\" data-nav=\"inbox\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#inbox\"></use></svg><span class=\"v2s-l\">Inbox</span><span class=\"v2s-n is-alert\">6</span></a><a class=\"v2s-item\" href=\"#\" data-nav=\"calendar\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#calendar\"></use></svg><span class=\"v2s-l\">Calendar</span></a><a class=\"v2s-item\" href=\"#\" data-nav=\"obligations\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#wallet\"></use></svg><span class=\"v2s-l\">Obligations &amp; payments</span></a><a class=\"v2s-item\" href=\"#\" data-nav=\"counterparties\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#building\"></use></svg><span class=\"v2s-l\">Counterparties</span></a><a class=\"v2s-item\" href=\"#\" data-nav=\"renewals\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#renewals\"></use></svg><span class=\"v2s-l\">Renewals &amp; approvals</span></a><a class=\"v2s-item\" href=\"#\" data-nav=\"trash\"><svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#trash\"></use></svg><span class=\"v2s-l\">Trash</span></a></nav>\n        <div class=\"v2s-recent\" id=\"v2Recent\"><div class=\"v2s-sub\">Recent</div><a class=\"v2s-rc is-active\" href=\"#\" data-recent=\"sample-msa-en-c6fd5671\" aria-current=\"true\"><span class=\"v2-sr\">Critical</span><span class=\"v2s-rt\">Master Services Agreement</span></a><a class=\"v2s-rc\" href=\"#\" data-recent=\"demo-logi\"><span class=\"v2-sr\">Critical</span><span class=\"v2s-rt\">Logistics Framework Agreement</span></a><a class=\"v2s-rc\" href=\"#\" data-recent=\"demo-pay\"><span class=\"v2-sr\">High</span><span class=\"v2s-rt\">Payroll Services Agreement</span></a><a class=\"v2s-rc\" href=\"#\" data-recent=\"demo-dpa\"><span class=\"v2-sr\">Critical</span><span class=\"v2s-rt\">Data Processing Addendum</span></a><a class=\"v2s-rc\" href=\"#\" data-recent=\"demo-lic\"><span class=\"v2-sr\">High</span><span class=\"v2s-rt\">Software Licence Agreement</span></a></div>\n        <footer class=\"v2s-foot\" id=\"libFoot\">\n          <!-- The run dock (v2/run.js mountDock): present only while an analysis runs. -->\n          <div class=\"v2-run-dock\" id=\"v2RunDock\"></div>\n          \n          <div class=\"v2s-meslot\" id=\"v2Me\"><button class=\"v2s-me\" id=\"v2Avatar\" type=\"button\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-controls=\"v2AvatarMenu\"><span class=\"v2s-av\" aria-hidden=\"true\">AM</span><span class=\"v2s-me-t\"><b>Alex Morgan</b><small>Member</small></span><svg class=\"v2i v2s-me-c\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#chevrons-up-down\"></use></svg></button></div>\n        </footer>\n        <!-- THE DOCUMENTS THAT GOVERN THIS PRODUCT (WS11-T02) are in Settings › Legal & security only, one per line (the owner,\n             2026-10-13: not under the account button). The same list is in admin.html; interface/tests/run.mjs holds the two to one\n             set of links, each to a page that exists in Landing/site/. -->\n      </aside>\n      <!-- The sidebar's right edge: drag it (or use the arrow keys) to widen it, up to half again its default width. -->\n      \n      <!-- The shade behind the sidebar drawer: a tap on the page beside it closes it. Never shown while it is docked. -->\n      <div class=\"lib-scrim\" id=\"libScrim\" aria-hidden=\"true\"></div>\n\n      <!-- THE ONE TOP BAR: breadcrumbs, the page's actions, the Inbox bell and + New - for the app's pages and the Docs pages. -->\n      <header class=\"v2-top\" id=\"v2Top\" data-v2-shell=\"1\">\n        <button class=\"v2t-ico v2t-menu\" id=\"libToggle\" type=\"button\" aria-label=\"Show panel\" aria-controls=\"library\" aria-expanded=\"false\">\n          <svg class=\"v2i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#menu\"></use></svg>\n        </button>\n        <nav class=\"v2t-crumbs\" id=\"v2Crumbs\" aria-label=\"Breadcrumb\"><span class=\"v2t-now\" aria-current=\"page\">Report</span></nav>\n        \n        <!-- HELP FOR THIS PAGE (v2/help.js): one quiet icon, the same place on every page - its playthroughs, the search, the keys -->\n        <button class=\"v2t-ico v2t-help\" id=\"v2Help\" type=\"button\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-label=\"Help for this page\" data-tip=\"Help for this page\" data-tip-pos=\"below\">\n          <svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#help\"></use></svg>\n        </button>\n        <button class=\"v2t-ico v2t-bell\" id=\"v2Bell\" type=\"button\" aria-label=\"Inbox\" data-tip=\"Your Inbox: late dates, decisions and finished analyses.\" data-tip-pos=\"below\">\n          <svg class=\"v2i\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#bell\"></use></svg>\n          \n        </button>\n        <button class=\"v2t-new\" id=\"v2New\" type=\"button\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-tip=\"Upload files or a folder, start a blank document, or make a folder.\" data-tip-pos=\"below\">\n          <svg class=\"v2i\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#plus\"></use></svg>\n          \n        </button>\n      </header>\n\n      <!-- Main: the contract workspace header + tabs (#modeBar) over the page (#modeStage). -->\n      <main class=\"main\" id=\"main\">\n        <header class=\"mode-bar\" id=\"modeBar\"><!-- the contract's header and tabs, injected here --><div class=\"ws-head\"><div class=\"ws-row\"><h1 class=\"ws-title\"><span>Master Services Agreement</span></h1><span class=\"ws-pill is-draft\">Draft</span><button type=\"button\" class=\"vr-chip\" data-vr-chip=\"sample-msa-en-c6fd5671\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-label=\"Versions\" data-tip=\"Versions\"><span class=\"vr-mono\">v1</span></button><button class=\"ws-more\" type=\"button\" data-ws-more=\"sample-msa-en-c6fd5671\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-label=\"More for this contract\" data-tip=\"Rename, download, duplicate, replace or delete this contract.\"><svg class=\"v2i\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#more\"></use></svg></button></div><div class=\"ws-prog\"><ol class=\"ws-steps\" aria-label=\"Progress\"><li class=\"is-done\"><i aria-hidden=\"true\"><svg class=\"v2i\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#check\"></use></svg></i><span class=\"ws-st-l\">Read</span></li><li class=\"is-done\"><i aria-hidden=\"true\"><svg class=\"v2i\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#check\"></use></svg></i><span class=\"ws-st-l\">Analysis</span></li><li class=\"is-done\"><i aria-hidden=\"true\"><svg class=\"v2i\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#check\"></use></svg></i><span class=\"ws-st-l\">Report</span></li><li class=\"is-now\" aria-current=\"step\"><i aria-hidden=\"true\"></i><span class=\"ws-st-l\">Sign</span></li></ol></div></div><nav class=\"ws-tabs ws-tabs-r\" role=\"tablist\" aria-label=\"Contract\" data-ml-own-style=\"\" style=\"--ws-tabs-end: 0px;\"><a class=\"ws-tab\" role=\"tab\" href=\"#\" data-ws-tab=\"detect\" data-ws-mode=\"detect\" data-ws-job=\"sample-msa-en-c6fd5671\" aria-selected=\"false\"><span>Findings</span><span class=\"ws-tab-n\">9</span></a><a class=\"ws-tab\" role=\"tab\" href=\"#\" data-ws-tab=\"draft\" data-ws-mode=\"draft\" data-ws-job=\"sample-msa-en-c6fd5671\" aria-selected=\"false\"><span>Document</span></a><a class=\"ws-tab\" role=\"tab\" href=\"#\" data-ws-tab=\"whatif\" data-ws-mode=\"whatif\" data-ws-job=\"sample-msa-en-c6fd5671\" aria-selected=\"false\"><span>What if</span></a><a class=\"ws-tab is-active\" role=\"tab\" href=\"#\" data-ws-tab=\"report\" data-ws-mode=\"report\" data-ws-job=\"sample-msa-en-c6fd5671\" aria-selected=\"true\" aria-current=\"page\"><span>Report</span></a><a class=\"ws-tab\" role=\"tab\" href=\"#\" data-ws-tab=\"dates\" data-ws-docs=\"deadlines\" data-ws-job=\"sample-msa-en-c6fd5671\" aria-selected=\"false\"><span>Dates</span></a><a class=\"ws-tab\" role=\"tab\" href=\"#\" data-ws-tab=\"activity\" data-ws-docs=\"activity\" data-ws-job=\"sample-msa-en-c6fd5671\" aria-selected=\"false\"><span>Activity</span></a><a class=\"ws-tab\" role=\"tab\" href=\"#\" data-ws-tab=\"history\" data-ws-docs=\"history\" data-ws-job=\"sample-msa-en-c6fd5671\" aria-selected=\"false\"><span>History</span></a></nav></header>\n        <div class=\"mode-stage is-samestage\" id=\"modeStage\">\n      <div class=\"report-layout rpt-genwrap\" style=\"\">\n        <section class=\"rpt-gen risk-high\" aria-labelledby=\"rptGenH\">\n          <div class=\"rgn-top\"><span class=\"rgn-eyebrow\">Report</span><span class=\"rgn-doc\">Master Services Agreement</span></div>\n          <h1 class=\"rgn-h\" id=\"rptGenH\">Do not sign until 4 items are fixed</h1>\n          <div class=\"rgn-bar\" aria-hidden=\"true\"><i class=\"rgn-seg sev-critical\" style=\"--w:1;--i:0\"></i><i class=\"rgn-seg sev-high\" style=\"--w:3;--i:1\"></i><i class=\"rgn-seg sev-medium\" style=\"--w:2;--i:2\"></i><i class=\"rgn-seg sev-low\" style=\"--w:3;--i:3\"></i></div>\n          <div class=\"rgn-counts\" aria-label=\"Findings by severity\">\n            \n            <span class=\"rgn-c is-critical\"><b>1</b><span>Critical</span></span><span class=\"rgn-c is-high\"><b>3</b><span>High</span></span><span class=\"rgn-c is-medium\"><b>2</b><span>Medium</span></span><span class=\"rgn-c is-low\"><b>3</b><span>Low</span></span>\n            <span class=\"rgn-c is-total\"><b>9</b><span>Total</span></span>\n          </div>\n          <div class=\"rgn-cta\"><button type=\"button\" class=\"rgn-go\" data-act=\"rpt-generate\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path d=\"M12 3.6l1.7 4.6 4.7 1.7-4.7 1.7L12 16.3l-1.7-4.7-4.7-1.7 4.7-1.7z\" fill=\"currentColor\"></path><path d=\"M18.4 15.2l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z\" fill=\"currentColor\"></path></svg><span>Generate report</span></button></div>\n        </section>\n      </div></div>\n      </main>\n\n      <!-- Docs: the account's documents, deadlines and counterparties (clm.js), drawn in the same place as the app's pages, under the\n           same sidebar and top bar. Its menus, sheets, tips and toasts are inside it, so its styles (.dx) reach them. Its own side nav\n           and top bar are retired (the shell's are the Docs pages' too); the elements stay, empty, for older code that looks them up. -->\n      \n\n      <!-- The phone's bottom tab bar (coarse pointers, narrow screens): Home, Contracts, Inbox, Ask, Menu. -->\n      <nav class=\"v2-tabbar\" id=\"v2TabBar\" aria-label=\"Pages\"><a class=\"v2tb-i\" href=\"#\" data-nav=\"home\"><span class=\"v2tb-ic\"><svg class=\"v2i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#home\"></use></svg></span><span>Home</span></a><a class=\"v2tb-i is-active\" href=\"#\" data-nav=\"contracts\" aria-current=\"page\"><span class=\"v2tb-ic\"><svg class=\"v2i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#contracts\"></use></svg></span><span>Contracts</span></a><a class=\"v2tb-i\" href=\"#\" data-nav=\"inbox\"><span class=\"v2tb-ic\"><svg class=\"v2i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#inbox\"></use></svg><i class=\"v2tb-n\">6</i></span><span>Inbox</span></a><a class=\"v2tb-i\" href=\"#\" data-nav=\"ask\"><span class=\"v2tb-ic\"><svg class=\"v2i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#ask\"></use></svg></span><span>Ask</span></a><button class=\"v2tb-i\" type=\"button\" data-act=\"v2-drawer\" aria-controls=\"library\" aria-label=\"Menu\"><span class=\"v2tb-ic\"><svg class=\"v2i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/v3/theatre/icons.svg#menu\"></use></svg></span><span>Menu</span></button></nav>\n\n      <!-- Modal / palette / toast / popover hosts -->\n      <div class=\"modal-root\" id=\"modalRoot\"></div>\n      <div class=\"palette-root\" id=\"paletteRoot\"></div>\n      <div class=\"popover-root\" id=\"popoverRoot\"></div>\n      <div class=\"toast-root\" id=\"toastRoot\" role=\"status\" aria-live=\"polite\" aria-label=\"Notifications\"></div>\n      <div class=\"toast-root toast-root--top\" id=\"toastRootTop\" role=\"status\" aria-live=\"polite\" aria-label=\"Notifications\"></div>\n    </div>\n\n    <!-- Dedicated full-screen sign-in / create-account page. Gates the whole\n         app; shown until a session exists, brought back on logout. -->\n    <!-- v2 (area brand): on the reader's theme (theme-boot stamps body[data-theme]; v2/auth.css carries the screen's own\n         palette per theme), the three-blade mark, and the lattice mark on ONE canvas (v2/auth.js): it assembles once and\n         stops; the SVG mark on phones and without a canvas. Motion is always on: no Pause button. -->\n    \n\n    <!-- Forced password change. Raised when the session's credential was\n         issued by an administrator: the server answers every other route with\n         403 \"password change required\" until it is replaced, so this gate has\n         no close control and Sign out is its only other action. -->\n    \n\n    <!-- Language pack + runtime load FIRST: i18n.js installs its observer before\n         any renderer runs, so the very first paint is already in the stored\n         language and nothing flashes English on the way. -->\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    <!-- The motion and render layer (window.SentinelMotion) on Motion v14 (vendor/motion.js, MIT): after the language\n         layer, whose originals its morph compares against, and before every script that renders. -->\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    <!-- The original document, as uploaded, beside the parse (Draft: Original / Side by side). The Word renderer it needs\n         (vendor/docx-preview.min.js, vendor/jszip.min.js) is loaded only when a Word file is shown. -->\n    \n    <!-- Files, as an explorer: the account's folders (backend/drive.py) and the documents filed in them. -->\n    \n    <!-- The Detect run's progress QUEUE and its state machine: the timing\n         rules that turn a cached re-run's bursts into a readable sequence,\n         kept out of app.js so a fake clock can drive them in the tests. -->\n    \n    <!-- v2 redesign modules (interface/v2/): loaded before clm.js and app.js, which call them. -->\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    <!-- the Insights agent (its box, its widgets, the To-do list, \"Make this a rule\"): before parsed-view draws a toolbar and the\n         Insights pages mount it -->\n    \n    <!-- a document's versions (the header's chip, the Versions panel, a clause's history), its change list and the Word export\n         window: before clm.js and app.js, which draw them -->\n    \n    \n    <!-- the paper's measures and words, and the print page's preparation the window's preview shares (v2/paper.js, v2/docprint.js):\n         before the export window, which reads them -->\n    \n    \n    \n    <!-- Home's horizon: the voice-glow port (MIT, v2/LICENSE-voice-glow.txt), laid along the band's foot by home.js -->\n    \n    \n    \n    \n    <!-- the Insights pages (#/insights...): after pages.js, whose kit they use, and before clm.js, which draws them -->\n    \n    <!-- the review workspace (#/insights/<id>): after insight.js, whose kit it is built with; its evidence pane after it -->\n    \n    \n    <!-- setting up a review and changing it in place: the pieces both use (the documents table, the rules with switches, Read as), the\n         header's lens that changes a review where it stands, and the composer in two panes - after the workspace, whose lens they fill -->\n    \n    \n    \n    <!-- the workspace's views over its stand-ins - the Table, the Documents, the Requests - and the Export panel (E): after the\n         workspace, whose registry they register in, and its pane, whose pure parts the Table's card uses -->\n    \n    \n    \n    \n    <!-- Ask or tell (#/insights...): after the workspace, whose registry it plugs into, and before the Askbot, whose Ctrl+/ it takes on\n         these pages -->\n    \n    <!-- Insights, Prepare (#/insights/prepare, #/insights/rooms/<rid>): after pages.js, whose page kit and crumbs it builds on, before\n         clm.js, which draws it -->\n    \n    <!-- deals (the owner's decision 5: a label grouping reviews, rooms and to-dos) and their picker, then Insights Home by deal (#/insights,\n         routed from v2/insight.js): after insight.js, whose kit they use, before clm.js, which draws them -->\n    \n    \n    \n    <!-- Help (#/help, #/welcome) and the tour's API: after pages.js, whose page kit it uses, before clm.js, which draws it and asks the\n         tour when it is due. The player (demo.js, demo-kit.js, help-plays.js, demo.css) is loaded by it on first use. -->\n    \n    <!-- Docs, a page of the app: loaded before app.js, drawn only when the app shows it (SentinelDocs.enter). -->\n    \n    \n    <!-- Askbot's face (v2/fx-bot.js, bot-avatars of libraries.dev): before the Askbot, which wears it -->\n    \n    <!-- the Askbot (SNT-158): after the app, which it asks who is signed in and what is open -->\n    \n      <!-- where the two effects go, on every page (v2/fx-places.js): last, so every page it watches is up -->\n    \n\n\n<section class=\"v2ab is-shut\" aria-label=\"Askbot\" style=\"left: 322px; top: 714px; width: 46px; height: 46px;\"><button type=\"button\" class=\"v2ab-icon\" data-ab=\"icon\" aria-expanded=\"false\" aria-keyshortcuts=\"Control+/\" aria-label=\"Askbot\"><span class=\"v2ab-float\"><img src=\"data:image/png;base64,\" data-sx-canvas=\"1\" class=\"ba\" style=\"display: block; flex: 0 0 auto; width: 78px; height: 78px; margin: -18.2px -13px -7.8px; opacity: 1; transition: opacity 0.3s ease-out; pointer-events: none;;width:78px;height:78px\"></span></button></section>","html_attrs":{"data-motion":"full","data-lang":"en"},"html_class":"ml-vt-capable","body_class":"","body_attrs":{"data-theme":"midnight"},"body_style":"background: rgb(11, 13, 18);"}